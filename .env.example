# Optional path to a YAML configuration file.
# VIDEO_ANALYTICS_CONFIG=configs/default.yaml

VIDEO_ANALYTICS_LOG_LEVEL=INFO
VIDEO_ANALYTICS_OUTPUT_DIR=outputs
VIDEO_ANALYTICS_DATABASE_PATH=outputs/video_analytics.sqlite3
VIDEO_ANALYTICS_ONNX_PROVIDERS=CPUExecutionProvider
VIDEO_ANALYTICS_CONFIDENCE_THRESHOLD=0.40
VIDEO_ANALYTICS_IOU_THRESHOLD=0.70

# PostgreSQL analytical store and service-to-service authentication.
ANALYTICS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tarebar
ANALYTICS_READ_KEY=replace-with-a-long-random-secret
ANALYTICS_INGEST_KEY=replace-with-a-different-long-random-secret
VIDEO_ANALYTICS_INGEST_URL=http://127.0.0.1:8000/api/v1/ingest/minutes
ANALYTICS_OUTBOX_DIR=outputs/analytics-outbox
ANALYTICS_OUTBOX_MAX_FILES_PER_CAMERA=1440
ANALYTICS_EXPECTED_SAMPLES_PER_MINUTE=30
ANALYTICS_ROLLUP_INTERVAL_SECONDS=60
ANALYTICS_QUEUE_SLA_SECONDS=300
ANALYTICS_QUEUE_WARNING_SECONDS=300
ANALYTICS_QUEUE_CRITICAL_SECONDS=600
ANALYTICS_TIMEZONE=Asia/Tehran

# Always-on location accumulation. Independent of on-demand live/video jobs.
# Locked to 0.5 FPS (one processed frame every two seconds).
VIDEO_ANALYTICS_FLEET_ENABLED=true
VIDEO_ANALYTICS_FLEET_FPS=0.5
# Fleet/general dashboard tracker: bytetrack | stabletrack | deepocsort | botsort
VIDEO_ANALYTICS_TRACKER=stabletrack
VIDEO_ANALYTICS_FLEET_REFRESH_SECONDS=30
VIDEO_ANALYTICS_FLEET_MAX_CAMERAS=32
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554

# Path is resolved from the video_analytics_mvp project root.
VIDEO_ANALYTICS_DETECTOR_MODEL=../../All_weights/Weights_final/HumanDetection_light_input_640.onnx

# Qwen2.5-VL is downloaded by tarebar-deployment, never copied into this image.
VIDEO_INSIGHT_MODELS_DIR=../tarebar-deployment/models
VIDEO_INSIGHT_MODEL_DIRNAME=Qwen2.5-VL-3B-Instruct
VIDEO_INSIGHT_MODEL_PATH=/models/Qwen2.5-VL-3B-Instruct
VIDEO_INSIGHT_PRELOAD=true
# auto = unquantized bf16/fp16 when the weights fit in free VRAM with 4 GiB headroom, else 4-bit.
# bf16 | fp16 | 8bit | 4bit force one mode.
VIDEO_INSIGHT_PRECISION=auto
# Per-frame resolution bounds of the Qwen processor. Unset = follow the GPU size:
# 200704-1003520 from 12 GiB of VRAM on (a 720p frame keeps its resolution), else 65536-262144.
# VIDEO_INSIGHT_MIN_PIXELS=
# VIDEO_INSIGHT_MAX_PIXELS=

# Optional service token shared with the dashboard and fruit-pipeline (HS256 JWS).
# Empty/unset = no enforcement. Applies to /api/v1/* except management and ingest.
SERVICE_AUTH_SECRET=

# Opt-in cleanup of finished job directories older than N days (0 = disabled).
VIDEO_ANALYTICS_RETENTION_DAYS=0
# Seconds a cancelled job may keep running before terminate(); kill() follows 5 s later.
VIDEO_ANALYTICS_CANCEL_GRACE_SECONDS=10
